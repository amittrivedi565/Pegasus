// Cloudflare Workers config. Static files in public/ are served as-is (no build step);
// src/worker.js only runs for the paths in run_worker_first (SmartHomes subdomain routing).
// Deploy: npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pegasus-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/smarthomes", "/smarthomes.html"]
  }
}
