// Cloudflare Workers config. Static files in public/ are served as-is (no build step);
// src/worker.js only runs for the page paths in run_worker_first (canonical-address redirects
// and SmartHomes subdomain routing). Missing URLs get public/404.html with a 404 status.
// Deploy: npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pegasus-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/", "/index.html",
      "/construction", "/construction.html",
      "/hospitality", "/hospitality.html",
      "/smarthomes", "/smarthomes.html"
    ]
  }
}
